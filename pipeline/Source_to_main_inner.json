{
	"name": "Source_to_main_inner",
	"properties": {
		"activities": [
			{
				"name": "Read_table_details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * from ctrl.table_config where table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "start_time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Start-Time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_HH-mm-ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "source_to_landing_injestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Read_table_details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "start_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "@concat(\n    'select * from PUBLIC.',\n    activity('Read_table_details').output.firstRow.source_table_name\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "PostgreSqlTable1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet1",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    'landing_valume/',\n    activity('Read_table_details').output.firstRow.source_system,\n    '/',\n    activity('Read_table_details').output.firstRow.source_table_name,\n    '/',\n    variables('Start-Time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Landing_to_Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "source_to_landing_injestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/tapkeersagar@gmail.com/care_sync_repo/care_sync_databricks/Landing_to_bronze",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('Start-Time')",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read_table_details').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"source_system": {
							"value": "@activity('Read_table_details').output.firstRow.source_system",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze_to_silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing_to_Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/tapkeersagar@gmail.com/care_sync_repo/care_sync_databricks/bronze_to_silver",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('Start-Time')",
							"type": "Expression"
						},
						"Table Name": {
							"value": "@activity('Read_table_details').output.firstRow.source_table_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			}
		},
		"variables": {
			"Start-Time": {
				"type": "String"
			}
		},
		"annotations": []
	}
}